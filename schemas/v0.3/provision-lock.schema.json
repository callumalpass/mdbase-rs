{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdbase.dev/schemas/v0.3/provision-lock.schema.json",
  "title": "mdbase v0.3 application provision lock",
  "type": "object",
  "required": ["kind", "lock_version", "contributions"],
  "properties": {
    "kind": {
      "const": "mdbase.provision-lock"
    },
    "lock_version": {
      "const": 1
    },
    "contributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contribution"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },
    "contributor": {
      "type": "object",
      "required": [
        "application_id",
        "declaration_digest",
        "provision_digest",
        "requirement"
      ],
      "properties": {
        "application_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$"
        },
        "declaration_digest": {
          "$ref": "#/$defs/digest"
        },
        "provision_digest": {
          "$ref": "#/$defs/digest"
        },
        "requirement": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    },
    "contribution": {
      "type": "object",
      "required": ["path", "value", "contributors"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "contributors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contributor"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
